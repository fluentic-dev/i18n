{
  "name": "@fluentic/i18n-web",
  "version": "0.0.0",
  "description": "React web bindings and browser persistence for Fluentic i18n.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fluentic-dev/i18n.git",
    "directory": "packages/web"
  },
  "homepage": "https://fluenticstack.com/i18n/",
  "bugs": {
    "url": "https://github.com/fluentic-dev/i18n/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@fluentic/i18n": "workspace:*",
    "react": ">=18"
  },
  "devDependencies": {
    "@fluentic/i18n": "workspace:*",
    "react": "^19.2.0",
    "@types/react": "^19.2.14",
    "tsdown": "^0.22.1",
    "typescript": "^5.9.3"
  }
}
