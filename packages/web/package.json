{
  "name": "@fluentic/i18n-web",
  "version": "0.1.0-beta.5",
  "description": "React web bindings and browser persistence for Fluentic i18n.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fluentic-dev/i18n.git",
    "directory": "packages/web"
  },
  "homepage": "https://fluenticstack.com/i18n/",
  "bugs": {
    "url": "https://github.com/fluentic-dev/i18n/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "test": "pnpm build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@fluentic/i18n": ">=0.1.0-beta.2 <0.2.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@fluentic/i18n": "workspace:*",
    "@types/react": "^19.2.14",
    "react": "^19.2.0",
    "tsdown": "^0.22.1",
    "typescript": "^7.0.2"
  }
}
