{
  "name": "@fluentic/i18n",
  "version": "0.1.0-beta.5",
  "description": "Framework-independent internationalization primitives for Fluentic applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fluentic-dev/i18n.git",
    "directory": "packages/i18n"
  },
  "homepage": "https://fluenticstack.com/i18n/",
  "bugs": {
    "url": "https://github.com/fluentic-dev/i18n/issues"
  },
  "type": "module",
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.js",
      "default": "./dist/adapter.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./hydration": {
      "types": "./dist/hydration.d.ts",
      "import": "./dist/hydration.js",
      "default": "./dist/hydration.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./compiled": {
      "types": "./dist/compiled.d.ts",
      "default": "./dist/compiled.js"
    },
    "./compiler-support": {
      "types": "./dist/compiler-support.d.ts",
      "default": "./dist/compiler-support.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm test:types && pnpm build && node --test test/*.test.mjs",
    "test:types": "tsc --ignoreConfig --noEmit --strict --skipLibCheck --esModuleInterop --module ESNext --moduleResolution Bundler --target ES2020 --lib ES2022,DOM --jsx react-jsx test/react.types.tsx test/compiled.types.ts"
  },
  "dependencies": {
    "intl-messageformat": "^10.7.16"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "react": "^19.2.0",
    "react-test-renderer": "19.3.1",
    "tsdown": "^0.22.1",
    "typescript": "^7.0.2",
    "typescript-language-service": "npm:typescript@5.9.3"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "sideEffects": [
    "./dist/react.js"
  ]
}
