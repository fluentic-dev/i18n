{
  "name": "@fluentic/i18n",
  "version": "0.1.0-beta.1",
  "description": "Framework-independent internationalization primitives for Fluentic applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fluentic-dev/i18n.git",
    "directory": "packages/i18n"
  },
  "homepage": "https://fluenticstack.com/i18n/",
  "bugs": {
    "url": "https://github.com/fluentic-dev/i18n/issues"
  },
  "type": "module",
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./adapter": {
      "types": "./src/adapter.ts",
      "import": "./dist/adapter.js",
      "default": "./dist/adapter.js"
    },
    "./react": {
      "types": "./src/react.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./types": {
      "types": "./src/types.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./compiled": {
      "types": "./src/compiled.ts",
      "default": "./dist/compiled.js"
    },
    "./compiler": {
      "types": "./src/compiler/index.ts",
      "default": "./dist/compiler.js"
    },
    "./plugin/babel": {
      "types": "./src/plugin/babel.ts",
      "import": "./dist/plugin/babel.js",
      "require": "./dist-cjs/babel.cjs"
    },
    "./plugin/vite": {
      "types": "./src/plugin/vite.ts",
      "default": "./dist/plugin/vite.js"
    },
    "./plugin/rollup": {
      "types": "./src/plugin/rollup.ts",
      "default": "./dist/plugin/rollup.js"
    },
    "./plugin/esbuild": {
      "types": "./src/plugin/esbuild.ts",
      "default": "./dist/plugin/esbuild.js"
    },
    "./plugin/webpack": {
      "types": "./src/plugin/webpack.ts",
      "default": "./dist/plugin/webpack.js"
    },
    "./plugin/webpack-loader": {
      "types": "./src/plugin/webpack-loader.ts",
      "default": "./dist/plugin/webpack-loader.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "dist-cjs"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm test:types && pnpm build && node --test test/*.test.mjs",
    "test:types": "tsc --noEmit --strict --skipLibCheck --esModuleInterop --module ESNext --moduleResolution Bundler --target ES2020 --jsx react-jsx test/react.types.tsx test/compiled.types.ts"
  },
  "dependencies": {
    "intl-messageformat": "^10.7.16",
    "@babel/parser": "^7.28.4",
    "@babel/traverse": "^7.28.4",
    "@babel/types": "^7.28.4",
    "@babel/generator": "^7.28.3",
    "@formatjs/icu-messageformat-parser": "2.11.4",
    "jiti": "^2.7.0",
    "@jridgewell/remapping": "^2.3.5",
    "@noble/hashes": "^1.8.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "react": "^19.2.0",
    "react-test-renderer": "19.3.1",
    "tsdown": "^0.22.1",
    "typescript": "^5.9.3",
    "@types/babel__traverse": "^7.20.7",
    "@types/babel__generator": "^7.27.0",
    "@types/node": "^22.15.0",
    "@babel/core": "^7.28.4"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "sideEffects": [
    "./dist/react.js"
  ]
}
