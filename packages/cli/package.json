{
  "name": "@fluentic/i18n-cli",
  "version": "0.0.0",
  "description": "Extraction, catalog, translation, and exchange tooling for Fluentic i18n.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fluentic-dev/i18n.git",
    "directory": "packages/cli"
  },
  "homepage": "https://fluenticstack.com/i18n/",
  "bugs": {
    "url": "https://github.com/fluentic-dev/i18n/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "fluentic-i18n": "./dist/bin.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@babel/parser": "^7.28.4",
    "@babel/traverse": "^7.28.4",
    "@babel/types": "^7.28.4",
    "@types/babel__traverse": "^7.20.7",
    "@types/node": "^22.15.0",
    "commander": "^14.0.0",
    "fast-glob": "^3.3.3",
    "tsdown": "^0.22.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "@fluentic/i18n": "workspace:*"
  }
}
