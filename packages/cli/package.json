{
  "name": "@fluentic/i18n-cli",
  "version": "0.1.0-beta.3",
  "description": "Extraction, catalog, translation, and exchange tooling for Fluentic i18n.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fluentic-dev/i18n.git",
    "directory": "packages/cli"
  },
  "homepage": "https://fluenticstack.com/i18n/",
  "bugs": {
    "url": "https://github.com/fluentic-dev/i18n/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "fluentic-i18n": "./dist/bin.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./translators": {
      "types": "./dist/translators.d.ts",
      "import": "./dist/translators.mjs",
      "default": "./dist/translators.mjs"
    },
    "./converters": {
      "types": "./dist/converter-api.d.ts",
      "import": "./dist/converters.mjs",
      "default": "./dist/converters.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "commander": "^14.0.0",
    "fast-glob": "^3.3.3",
    "tsdown": "^0.22.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fluentic/i18n-compiler": "workspace:*",
    "@xmldom/xmldom": "0.9.12",
    "jiti": "^2.7.0"
  }
}
