{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fluenticstack-sites-i18n",
  "compatibility_date": "2026-10-25",
  "main": "./src/worker.js",
  "routes": [
    {
      "pattern": "fluenticstack.com/i18n*",
      "zone_name": "fluenticstack.com"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./build",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}
