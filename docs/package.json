{
  "name": "@docs/app",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "docusaurus start --poll 1000 --no-open",
    "build": "docusaurus build",
    "cf:build": "DOCS_SITE=https://fluenticstack.com DOCS_BASE=/i18n docusaurus build",
    "cf:deploy": "npx wrangler@latest deploy",
    "cf": "pnpm run cf:build && pnpm run cf:deploy",
    "serve": "docusaurus serve",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/plugin-content-docs": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-classic": "^3.10.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@mdx-js/react": "^3.1.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "typescript": "^5.9.3"
  }
}
