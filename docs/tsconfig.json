{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "noEmit": true,
    "paths": { "@site/*": ["./*"] },
    "skipLibCheck": true
  },
  "include": ["src", "docusaurus.config.ts", "sidebars.ts"]
}
